# =============================================================================
# Data Engineering Project .gitignore
# =============================================================================

# ----------------------------- Data Files ------------------------------------
# Raw and processed data files (can be regenerated by pipeline)
data/raw/
data/processed/
data/warehouse/*.duckdb
data/warehouse/*.duckdb.wal
data/warehouse/*.duckdb.tmp
data/warehouse/.RData
data/warehouse/.Rhistory

# Keep data directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/warehouse/.gitkeep

# ----------------------------- Python -----------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ----------------------------- Virtual Environments ---------------------------
.env
.env.local
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ----------------------------- IDE / Editor -----------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ----------------------------- Jupyter Notebooks -------------------------------
.ipynb_checkpoints/
*.ipynb

# ----------------------------- OS Generated ------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ----------------------------- Logs & Temporary Files -------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# ----------------------------- AI & Development Artifacts ---------------------
# Remove these files before submission - they're for your reference only
CODE_CLEANUP_SUMMARY.md
NOTES.md
TODO.md
SCRATCH.md

# ----------------------------- Reports (Generated Files) ----------------------
# These are generated by the pipeline and can be recreated
# OPTIONAL: Uncomment if you want to exclude from Git (recommended for large repos)
# reports/*.csv
# reports/figures/*.png

# Keep report templates and documentation
!reports/decision_log.md
!reports/final_report_template.md
!reports/FINAL_ASSESSMENT_REPORT.md
!reports/ai_usage_disclosure.md

# ----------------------------- Secrets & Credentials --------------------------
# Never commit these!
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
credentials/
*_credentials.json
*_secret.json

# ----------------------------- DuckDB Database Files --------------------------
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.db-shm
*.db-wal



# =============================================================================
# End of .gitignore
# =============================================================================
